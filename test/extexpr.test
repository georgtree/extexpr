### Math functions tests
test logbProcTest-1 {} -match approxEqual -body {
    return [expr {logb(16,2)}]
} -result 4.0

test logbProcTest-2 {} -match approxEqual -body {
    return [expr {logb(16,3)}]
} -result 2.5237190142858297

test logbProcTest-3 {} -body {
    return [expr {logb(0,3)}]
} -result -Inf

cleanupTests
