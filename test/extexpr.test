package require tcltest
namespace import ::tcltest::*
package require extexpr

set atol 1e-15
set rtol 1e-14

proc containsNumber {value} {
    if {[string is double -strict $value]} {
        return true
    }
    if {[catch {llength $value} len]} {
        return false
    }
    # Single-element and empty values are treated as atoms here.
    if {$len<=1} {
        return false
    }
    for {set i 0} {$i<$len} {incr i} {
        if {[containsNumber [lindex $value $i]]} {
            return true
        }
    }
    return false
}

proc approxNestedEqual {a b} {
    variable atol
    variable rtol
    set aIsNum [string is double -strict $a]
    set bIsNum [string is double -strict $b]
    # Numeric atoms: approximate comparison
    if {$aIsNum && $bIsNum} {
        return [expr {abs($a-$b)<=($atol+$rtol*abs($b))}]
    }
    # One numeric, one non-numeric
    if {$aIsNum!=$bIsNum} {
        return false
    }
    set aHasNum [containsNumber $a]
    set bHasNum [containsNumber $b]
    # If neither side contains numbers, compare as exact strings.
    # This preserves spaces, tabs, etc.
    if {!$aHasNum && !$bHasNum} {
        return [string equal $a $b]
    }
    # If only one side contains numeric structure, they differ.
    if {$aHasNum != $bHasNum} {
        return false
    }
    # Both contain numbers somewhere, so compare structurally as lists.
    if {[catch {llength $a} lenA]} {
        return false
    }
    if {[catch {llength $b} lenB]} {
        return false
    }
    if {$lenA != $lenB} {
        return false
    }
    for {set i 0} {$i<$lenA} {incr i} {
        set elemA [lindex $a $i]
        set elemB [lindex $b $i]
        if {![approxNestedEqual $elemA $elemB]} {
            return false
        }
    }
    return true
}

customMatch approxEqual approxNestedEqual

### List operations tests
test maxlProcTest-1 {} -match approxEqual -setup {
    set y [list 0 1 4 9 16 25 36 49 64 81 100]
} -body {
    return [expr {maxl($y)}]
} -result 100 -cleanup {
    unset y
}
test minlProcTest-1 {} -match approxEqual -setup {
    set y [list 0 1 4 9 16 25 36 49 64 81 100]
} -body {
    return [expr {minl($y)}]
} -result 0 -cleanup {
    unset y
}

### mul tests
test mulProcTest-1 {} -match approxEqual -setup {
    set y [list 0 1 4 9 16 25 36 49 64 81 100]
} -body {
    return [expr {mul($y,2)}]
} -result {0.0 2.0 8.0 18.0 32.0 50.0 72.0 98.0 128.0 162.0 200.0} -cleanup {
    unset y
}
test mulProcTest-2 {} -match approxEqual -setup {
    set y [list 0 1 4 9 16 25 36 49 64 81 100]
} -body {
    return [expr {mul(2,$y)}]
} -result {0.0 2.0 8.0 18.0 32.0 50.0 72.0 98.0 128.0 162.0 200.0} -cleanup {
    unset y
}
test mulProcTest-3 {} -match approxEqual -body {
    return [expr {mul(2,2)}]
} -result 4.0
test mullProcTest-4 {} -setup {
    set x [list 0 1 4 9 16 25 36 49 64 81 100]
    set y [list 0 1 4 9 16 25 36 49 64 81 100]
} -body {
    return [expr {mul($x,$y)}]
} -result {0.0 1.0 16.0 81.0 256.0 625.0 1296.0 2401.0 4096.0 6561.0 10000.0} -cleanup {
    unset x y
}
test mulProcTest-5 {} -setup {
    set y [list 0 1 4 9 16 25 36 49 64 81 100]
} -body {
    catch {expr {mul($y)}} errorStr
    return $errorStr
} -result {wrong # args: should be one of the following:
  tcl::mathfunc::mul list list
  tcl::mathfunc::mul list value
  tcl::mathfunc::mul value list
  tcl::mathfunc::mul value value
  or use [expr] syntax: mul(arg1,arg2) with any of the argument combinations above} -cleanup {
    unset y errorStr
}
test mulProcTest-6 {} -setup {
    set y [list 0 1 4 9 16 25 36 49 64 81 100]
} -body {
    catch {expr {mul($y,{a})}} errorStr
    return $errorStr
} -result {expected floating-point number but got "a"} -cleanup {
    unset y errorStr
}
test mulProcTest-7 {} -setup {
    set y [list 0 1 4 v 16 25 36 49 64 81 100]
} -body {
    catch {expr {mul($y,2)}} errorStr
    return $errorStr
} -result {expected floating-point number but got "v"} -cleanup {
    unset y
}
test mulProcTest-8 {} -setup {
    set y [list 0 1 4 8 16 25 36 49 64 81 100]
} -body {
    catch {expr {mul($y,[list])}} errorStr
    return $errorStr
} -result {Empty list is not allowed as scalar input} -cleanup {
    unset y
}

