### div tests
test divProcTest-1 {} -match approxEqual -setup {
    set y [list 0 1 4 9 16 25 36 49 64 81 100]
} -body {
    return [expr {div($y,2)}]
} -result {0.0 0.5 2.0 4.5 8.0 12.5 18.0 24.5 32.0 40.5 50.0} -cleanup {
    unset y
}
test divProcTest-2 {} -match approxEqual -setup {
    set y [list 1 1 4 9 16 25 36 49 64 81 100]
} -body {
    return [expr {div(2,$y)}]
} -result {2.0 2.0 0.5 0.2222222222222222 0.125 0.08 0.05555555555555555 0.04081632653061224 0.03125\
0.024691358024691357 0.02} -cleanup {
    unset y
}
test divProcTest-3 {} -match approxEqual -body {
    return [expr {div(2,2)}]
} -result 1.0
test divProcTest-4 {} -match approxEqual -setup {
    set x [list 0 1 4 9 16 25 36 49 64 81 101]
    set y [list 1 1 4 9 13 25 36 45 64 81 100]
} -body {
    return [expr {div($x,$y)}]
} -result {0.0 1.0 1.0 1.0 1.2307692307692308 1.0 1.0 1.0888888888888888 1.0 1.0 1.01} -cleanup {
    unset x y
}
test divlscProcTest-5 {} -setup {
    set y [list 0 1 4 9 16 25 36 49 64 81 100]
} -body {
    catch {expr {div($y,0)}} errorStr
    return $errorStr
} -result {Division by zero} -cleanup {
    unset y errorStr
}
test divlscProcTest-6 {} -setup {
    set y [list 0 1 4 9 16 25 36 49 64 81 100]
} -body {
    catch {expr {div(1,$y)}} errorStr
    return $errorStr
} -result {Division by zero} -cleanup {
    unset y errorStr
}

### pow tests
test powProcTest-1 {} -match approxEqual -setup {
    set y [list 0 1 4 9 16 25 36 49 64 81 100]
} -body {
    return [expr {pow($y,2)}]
} -result {0.0 1.0 16.0 81.0 256.0 625.0 1296.0 2401.0 4096.0 6561.0 10000.0} -cleanup {
    unset y
}
test powProcTest-2 {} -match approxEqual -setup {
    set y [list 1 1 4 9 16 25 36 49 64 81 100]
} -body {
    return [expr {pow(2,$y)}]
} -result {2.0 2.0 16.0 512.0 65536.0 33554432.0 68719476736.0 562949953421312.0 1.844674407370955e+19\
2.4178516392292583e+24 1.2676506002282294e+30} -cleanup {
    unset y
}
test powProcTest-3 {} -match approxEqual -body {
    return [expr {pow(2,2)}]
} -result 4.0
test powProcTest-4 {} -setup {
    set x [list 0 1 4 9 16]
    set y [list 1 1 4 9 13]
} -body {
    return [expr {pow($x,$y)}]
} -result {0.0 1.0 256.0 387420489.0 4503599627370496.0} -cleanup {
    unset x y
}
test powProcTest-5 {} -setup {
    set y [list 0 1 4 -9 16 25 36 49 64 81 100]
} -body {
    catch {expr {pow($y,0.5)}} errorStr
    return $errorStr
} -result {Negative base cannot be raised to a non-integer power} -cleanup {
    unset y errorStr
}
test powProcTest-6 {} -setup {
    set y [list 0 1 4 0.5 16 25 36 49 64 81 100]
} -body {
    catch {expr {pow(-2,$y)}} errorStr
    return $errorStr
} -result {Negative base cannot be raised to a non-integer power} -cleanup {
    unset y errorStr
}

### dot tests
test dotProcTest-1 {} -match approxEqual -body {
    return [expr {dot(2,2)}]
} -result 4.0
test dotProcTest-2 {} -setup {
    set x [list 0 1 4 9 16 25 36 49 64 81 100]
    set y [list 0 1 4 9 16 25 36 49 64 81 100]
} -body {
    return [expr {dot($x,$y)}]
} -result {25333.0} -cleanup {
    unset x y
}
test dotProcTest-3 {} -setup {
    set y [list 0 1 4 9 16 25 36 49 64 81 100]
} -body {
    catch {expr {dot($y,2)}} errorStr
    return $errorStr
} -result {Dot product elements must be the same length} -cleanup {
    unset y
}

